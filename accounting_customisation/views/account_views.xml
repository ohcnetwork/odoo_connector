<odoo>
    <data>

        <record id="view_move_form_inherit_tax_" model="ir.ui.view">
            <field name="name">account.move.form.view.inherit.tax</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>

            <field name="arch" type="xml">

                <!-- Insert inside "Other Info" tab -->
                <xpath expr="//page[@name='other_info']/group" position="inside">
                    <group string="Tax Information">
                        <field name="taxed_invoice" readonly="1"/>
                        <field name="untaxed_invoice" readonly="1"/>
                    </group>
                </xpath>


            </field>
        </record>


        <record id="view_journal_form_inherit_tax_" model="ir.ui.view">
            <field name="name">.account.journal.form.inherit</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>

            <field name="arch" type="xml">

                <!-- Insert inside "Other Info" tab -->
                <xpath expr="//page[@name='advanced_settings']/group" position="inside">
                    <group string="Tax Information">
                        <field name="is_taxed_journal" readonly="0"/>
                        <field name="is_untaxed_journal" readonly="0"/>
                    </group>
                </xpath>

            </field>
        </record>


    </data>
</odoo>