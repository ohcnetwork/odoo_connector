<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_inherit_care" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.care</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('settings')]" position="inside">
                    <div class="app_settings_block" data-string="Care Connector" string="Care Connector" data-key="care_connector">
                        <h2>Care Integration Settings</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <label for="care_base_url"/>
                                    <div class="text-muted">
                                        Base URL for the Care system to enable back linking from Odoo records
                                    </div>
                                    <field name="care_base_url" placeholder="https://care.example.com"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
