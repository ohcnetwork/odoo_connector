<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_partner_form_view" model="ir.ui.view">
            <field name="name">res.partner.form.view</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='function']" position="after">
                    <field name="ref" readonly="1"/>
                    <field name="x_care_id" readonly="1"/>
                    <field name="x_care_id_type" readonly="1"/>
                    <field name="x_gender"/>
                    <field name="x_birthdate"/>
                    <field name="x_age" readonly="1"/>
                </xpath>
                <xpath expr="//page[@name='sales_purchases']" position="after">
                    <page string="Allowed Payment Methods" name="allowed_payment_methods">
                        <group>
                            <field name="x_care_credit_journal_id" invisible="1"/>
                            <field name="x_allowed_payment_method_line_ids" widget="many2many_tags"
                                   domain="[('journal_id', '=', x_care_credit_journal_id), ('payment_type', '=', 'inbound')]"
                                   options="{'no_create': True}"
                                   placeholder="Select allowed payment methods for this partner"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>