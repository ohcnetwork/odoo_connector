<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_care_register_reports" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.care.register.reports</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="GST Register Reports" name="care_register_reports">
                    <block title="Stock Accounts" name="care_stock_accounts_block">
                        <setting id="care_stock_sales_accounts_setting"
                                 string="Stock Sales Accounts"
                                 help="The sales registers count only lines posted to these accounts unless changed on the report.">
                            <field name="care_stock_sales_account_ids" widget="many2many_tags"
                                   domain="[('account_type', 'in', ('income', 'income_other'))]"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
