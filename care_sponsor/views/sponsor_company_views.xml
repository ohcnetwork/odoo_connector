<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Sponsor Company List View -->
    <record id="sponsor_company_view_list" model="ir.ui.view">
        <field name="name">sponsor.company.list</field>
        <field name="model">sponsor.company</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="city"/>
                <field name="account_id"/>
                <field name="invoice_count" string="Invoices"/>
                <field name="total_outstanding" string="Outstanding"/>
            </list>
        </field>
    </record>

    <!-- Sponsor Company Form View -->
    <record id="sponsor_company_view_form" model="ir.ui.view">
        <field name="name">sponsor.company.form</field>
        <field name="model">sponsor.company</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="invoice_count == 0">
                            <div class="o_stat_info">
                                <field name="invoice_count" class="o_stat_value"/>
                                <span class="o_stat_text">Invoices</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Company Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="code"/>
                            <field name="account_id" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Financial Summary">
                            <field name="total_invoiced"/>
                            <field name="total_outstanding"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contact &amp; Address">
                            <group>
                                <group string="Contact Information">
                                    <field name="phone" widget="phone"/>
                                    <field name="mobile" widget="phone"/>
                                    <field name="email" widget="email"/>
                                    <field name="website" widget="url"/>
                                </group>
                                <group string="Address">
                                    <field name="street"/>
                                    <field name="street2"/>
                                    <field name="city"/>
                                    <field name="state_id"/>
                                    <field name="zip"/>
                                    <field name="country_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Contact Person">
                            <group>
                                <group>
                                    <field name="contact_name"/>
                                    <field name="contact_designation"/>
                                </group>
                                <group>
                                    <field name="contact_phone" widget="phone"/>
                                    <field name="contact_email" widget="email"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Sponsor Company Search View -->
    <record id="sponsor_company_view_search" model="ir.ui.view">
        <field name="name">sponsor.company.search</field>
        <field name="model">sponsor.company</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="city"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="City" name="group_city" context="{'group_by': 'city'}"/>
                <filter string="State" name="group_state" context="{'group_by': 'state_id'}"/>
                <filter string="Country" name="group_country" context="{'group_by': 'country_id'}"/>
            </search>
        </field>
    </record>

    <!-- Sponsor Company Kanban View -->
    <record id="sponsor_company_view_kanban" model="ir.ui.view">
        <field name="name">sponsor.company.kanban</field>
        <field name="model">sponsor.company</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="code"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="invoice_count"/>
                <field name="total_outstanding"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <span t-if="record.code.raw_value" class="text-muted">
                                        [<field name="code"/>]
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="phone" widget="phone"/>
                                <field name="email" widget="email"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span><field name="invoice_count"/> Invoices</span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span class="text-danger" t-if="record.total_outstanding.raw_value > 0">
                                        <field name="total_outstanding" widget="monetary"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Sponsor Company Action -->
    <record id="sponsor_company_action" model="ir.actions.act_window">
        <field name="name">Sponsor Companies</field>
        <field name="res_model">sponsor.company</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first sponsor company
            </p>
            <p>
                Define corporate sponsors who pay invoices on behalf of customers
                (e.g., companies paying for employee treatments).
            </p>
        </field>
    </record>

    <!-- Root Menu -->
    <menuitem id="menu_sponsor_root"
              name="Sponsors"
              web_icon="care_sponsor,static/description/icon.png"
              sequence="45"/>

    <!-- Sponsors Menu -->
    <menuitem id="menu_sponsor_companies"
              name="Sponsor Companies"
              parent="menu_sponsor_root"
              action="sponsor_company_action"
              sequence="10"/>
</odoo>

