<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Cash Denomination Security Groups -->
        <record id="module_category_cash_denomination" model="ir.module.category">
            <field name="name">Cash Denomination</field>
            <field name="description">Cash denomination and transfer management</field>
            <field name="sequence">50</field>
        </record>

        <!-- Cashier Group - Can create and submit denominations -->
        <record id="group_cash_denomination_cashier" model="res.groups">
            <field name="name">Cashier</field>
            <field name="category_id" ref="module_category_cash_denomination"/>
            <field name="comment">Can create and submit cash denominations for their own counter</field>
        </record>

        <!-- Manager Group - Can approve/reject denominations -->
        <record id="group_cash_denomination_manager" model="res.groups">
            <field name="name">Cash Manager</field>
            <field name="category_id" ref="module_category_cash_denomination"/>
            <field name="implied_ids" eval="[(4, ref('group_cash_denomination_cashier'))]"/>
            <field name="comment">Can approve/reject cash denominations and manage configurations</field>
        </record>

        <!-- Record Rules -->
        
        <!-- Cashiers can only see their own denominations -->
        <record id="cash_denomination_cashier_rule" model="ir.rule">
            <field name="name">Cashier: Own Denominations Only</field>
            <field name="model_id" ref="model_cash_denomination"/>
            <field name="domain_force">[('user', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_cash_denomination_cashier'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Managers can see all denominations -->
        <record id="cash_denomination_manager_rule" model="ir.rule">
            <field name="name">Manager: All Denominations</field>
            <field name="model_id" ref="model_cash_denomination"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_cash_denomination_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Cashiers can see transfers they sent or received -->
        <record id="cash_transfer_cashier_rule" model="ir.rule">
            <field name="name">Cashier: Own Transfers Only</field>
            <field name="model_id" ref="model_cash_transfer"/>
            <field name="domain_force">['|', ('from_user', '=', user.id), ('accepted_by', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_cash_denomination_cashier'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Managers can see all transfers -->
        <record id="cash_transfer_manager_rule" model="ir.rule">
            <field name="name">Manager: All Transfers</field>
            <field name="model_id" ref="model_cash_transfer"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_cash_denomination_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Config access only for managers -->
        <record id="account_head_config_manager_rule" model="ir.rule">
            <field name="name">Manager: Config Access</field>
            <field name="model_id" ref="model_account_head_config"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_cash_denomination_manager'))]"/>
        </record>

    </data>
</odoo>
