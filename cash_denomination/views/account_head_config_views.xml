<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_account_head_config_form" model="ir.ui.view">
            <field name="name">account.head.config.form</field>
            <field name="model">account.head.config</field>
            <field name="arch" type="xml">
                <form string="Cash Denomination Configuration">
                    <sheet>
                        <group string="Configuration">
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Account Mapping">
                            <group>
                                <field name="debit_account_id" 
                                       options="{'no_create': True}"
                                       context="{'show_parent_account': True}"/>
                            </group>
                            <group>
                                <field name="credit_account_id" 
                                       options="{'no_create': True}"
                                       context="{'show_parent_account': True}"/>
                            </group>
                        </group>
                        <group string="Help">
                            <div class="alert alert-info" role="alert">
                                <p><strong>Configuration Guide:</strong></p>
                                <ul>
                                    <li><strong>Counter Account (Debit):</strong> Usually the Main Cash account where cash is collected (e.g., Cash in Hand - Main)</li>
                                    <li><strong>Counter Account (Credit):</strong> The counter's cash account that will be credited (e.g., Cash in Hand - Counter)</li>
                                </ul>
                                <p>When a cash denomination is approved, the system will:</p>
                                <ul>
                                    <li>Debit the Counter Account (Debit) with the denomination amount</li>
                                    <li>Credit the Counter Account (Credit) with the same amount</li>
                                </ul>
                            </div>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="view_account_head_config_list" model="ir.ui.view">
            <field name="name">account.head.config.list</field>
            <field name="model">account.head.config</field>
            <field name="arch" type="xml">
                <list string="Cash Denomination Configurations">
                    <field name="name"/>
                    <field name="debit_account_id"/>
                    <field name="credit_account_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <!-- Action -->
        <record id="action_account_head_config" model="ir.actions.act_window">
            <field name="name">Cash Denomination Configuration</field>
            <field name="res_model">account.head.config</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Configure account mapping for cash denomination
                </p>
                <p>
                    Set up the debit and credit accounts used when approving cash denominations.
                    Only one configuration per company is allowed.
                </p>
            </field>
        </record>

        <!-- Menu Item (Manager only) -->
        <menuitem id="menu_account_head_config"
                  name="Configuration"
                  parent="care_connector.menu_main_cash_denomination"
                  action="action_account_head_config"
                  sequence="10"
                  groups="cash_denomination.group_cash_denomination_manager"/>
    </data>
</odoo>
